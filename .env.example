# Configuration Cloudinary (hebergement medias client sans cle privee)
CLOUDINARY_CLOUD_NAME=CLOUDINARY_CLOUD_NAME_PLACEHOLDER
CLOUDINARY_UPLOAD_PRESET=CLOUDINARY_UPLOAD_PRESET_PLACEHOLDER
CLOUDINARY_UPLOAD_FOLDER=raven_media

# Variantes Firebase optionnelles (laisser par defaut pour utiliser google-services.json & firebase_applet_config.xml)
FIREBASE_DATABASE_ID=FIREBASE_DATABASE_ID_PLACEHOLDER
FIREBASE_WEB_CLIENT_ID=FIREBASE_WEB_CLIENT_ID_PLACEHOLDER
FIREBASE_PROJECT_ID=FIREBASE_PROJECT_ID_PLACEHOLDER
FIREBASE_APP_ID=FIREBASE_APP_ID_PLACEHOLDER
FIREBASE_API_KEY=FIREBASE_API_KEY_PLACEHOLDER
FIREBASE_MESSAGING_SENDER_ID=FIREBASE_MESSAGING_SENDER_ID_PLACEHOLDER
FIREBASE_STORAGE_BUCKET=FIREBASE_STORAGE_BUCKET_PLACEHOLDER
