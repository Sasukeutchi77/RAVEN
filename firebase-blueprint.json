      "description": "Owner-only hashed device trust registry."
    },
    "/users/{userId}/login_history/{eventId}": {
      "schema": { "$ref": "#/entities/LoginHistoryEntry" },
      "description": "Owner-only immutable login history records."
    },
    "/users/{userId}/security_alerts/{alertId}": {
      "schema": { "$ref": "#/entities/SecurityAlert" },
      "description": "Owner-only unusual activity and device security alerts."
    },
    "/users/{userId}/security_logs/{logId}": {
      "schema": { "$ref": "#/entities/SecurityLogEntry" },
      "description": "Owner-only immutable security audit journal."
    }
  }
}
