rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function serverDoc(serverId) {
      return get(/databases/$(database)/documents/servers/$(serverId));
    }

    function serverExists(serverId) {
      return exists(/databases/$(database)/documents/servers/$(serverId));
    }

    function isServerOwner(serverId) {
      return serverExists(serverId) && serverDoc(serverId).data.ownerId == request.auth.uid;
    }

    function isCommunityAdmin(serverId) {
      return serverExists(serverId) && (
        serverDoc(serverId).data.ownerId == request.auth.uid ||
        ('adminIds' in serverDoc(serverId).data && request.auth.uid in serverDoc(serverId).data.adminIds)
      );
    }

    function isServerClosed(serverId) {
      return serverExists(serverId) &&
             ('isClosed' in serverDoc(serverId).data) &&
             serverDoc(serverId).data.isClosed == true;
    }

    function isCommunityMod(serverId) {
      return serverExists(serverId) &&
             ('moderatorIds' in serverDoc(serverId).data && request.auth.uid in serverDoc(serverId).data.moderatorIds);
    }

    function isCommunityStaff(serverId) {
      return isCommunityAdmin(serverId) || isCommunityMod(serverId);
    }

    function isServerMemberOrPublic(serverId) {
      return serverExists(serverId) &&
             (serverDoc(serverId).data.isPublic == true ||
              serverDoc(serverId).data.ownerId == request.auth.uid ||
              request.auth.uid in serverDoc(serverId).data.memberIds);
    }

    function hasValidCommunityInvite(serverId, data) {
      return ('lastInviteCodeUsed' in data) &&
             isValidId(data.lastInviteCodeUsed) &&
             exists(/databases/$(database)/documents/community_invites/$(data.lastInviteCodeUsed)) &&
             get(/databases/$(database)/documents/community_invites/$(data.lastInviteCodeUsed)).data.serverId == serverId &&
             get(/databases/$(database)/documents/community_invites/$(data.lastInviteCodeUsed)).data.isRevoked == false;
    }

    function botDoc(botId) {
      return get(/databases/$(database)/documents/bots/$(botId));
    }

    function botExists(botId) {
      return exists(/databases/$(database)/documents/bots/$(botId));
    }

    function isBotOwner(botId) {
      return botExists(botId) && botDoc(botId).data.ownerUid == request.auth.uid;
    }

    function isValidBotHandle(data) {
      return data.handle is string && isValidId(data.handle) &&
             data.handle.size() >= 2 && data.handle.size() <= 40 &&
             data.botId is string && isValidId(data.botId) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 64));
    }

    function isValidBotDoc(data) {
      return data.id is string && isValidId(data.id) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 64 &&
             data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 40 &&
             data.isActive is bool &&
             !('token' in data) &&
             !('tokenHash' in data) &&
             !('apiKey' in data) &&
             !('secretHeader' in data) &&
             !('webhookSecret' in data) &&
             (!('isPublicCatalog' in data) || data.isPublicCatalog is bool) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 800)) &&
             (!('avatarColor' in data) || data.avatarColor is int) &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500)) &&
             (!('tokenPrefix' in data) || (data.tokenPrefix is string && data.tokenPrefix.size() <= 40)) &&
             (!('tokenVersion' in data) || data.tokenVersion is int) &&
             (!('defaultPermissions' in data) || (data.defaultPermissions is list && data.defaultPermissions.size() <= 30)) &&
             (!('commands' in data) || (data.commands is list && data.commands.size() <= 50)) &&
             (!('subscribedEvents' in data) || (data.subscribedEvents is list && data.subscribedEvents.size() <= 30)) &&
             (!('autoResponses' in data) || (data.autoResponses is list && data.autoResponses.size() <= 50)) &&
             (!('webhooksPublicMeta' in data) || (data.webhooksPublicMeta is list && data.webhooksPublicMeta.size() <= 20)) &&
             (!('enabledPluginIds' in data) || (data.enabledPluginIds is list && data.enabledPluginIds.size() <= 30)) &&
             (!('allowDirectMessages' in data) || data.allowDirectMessages is bool) &&
             (!('allowGroupMentions' in data) || data.allowGroupMentions is bool) &&
             (!('welcomeDmMessage' in data) || data.welcomeDmMessage == null || (data.welcomeDmMessage is string && data.welcomeDmMessage.size() <= 1000)) &&
             (!('starterPresetId' in data) || data.starterPresetId == null || (data.starterPresetId is string && data.starterPresetId.size() <= 80)) &&
             (!('rateLimit' in data) || data.rateLimit is map);
    }

    function isValidServerBotInstallation(data, serverId, botId) {
      return data.botId == botId &&
             data.serverId == serverId &&
             data.botName is string && data.botName.size() >= 1 && data.botName.size() <= 64 &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.installedByUid is string && data.installedByUid.size() >= 1 && data.installedByUid.size() <= 128 &&
             !('token' in data) &&
             !('tokenHash' in data) &&
             !('apiKey' in data) &&
             (!('botHandle' in data) || (data.botHandle is string && data.botHandle.size() <= 40)) &&
             (!('botAvatarUrl' in data) || data.botAvatarUrl == null || (data.botAvatarUrl is string && data.botAvatarUrl.size() <= 800)) &&
             (!('botAvatarColor' in data) || data.botAvatarColor is int) &&
             (!('grantedPermissions' in data) || (data.grantedPermissions is list && data.grantedPermissions.size() <= 30)) &&
             (!('assignedRoleTitle' in data) || data.assignedRoleTitle == null || (data.assignedRoleTitle is string && data.assignedRoleTitle.size() <= 64)) &&
             (!('assignedCustomRoleId' in data) || data.assignedCustomRoleId == null || (data.assignedCustomRoleId is string && data.assignedCustomRoleId.size() <= 128)) &&
             (!('isEnabledInServer' in data) || data.isEnabledInServer is bool);
    }

    function isValidBotLog(data) {
      return data.id is string && isValidId(data.id) &&
             data.botId is string && isValidId(data.botId) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 &&
             data.eventType is string && data.eventType.size() >= 1 && data.eventType.size() <= 64 &&
             data.status is string && data.status in ['SUCCESS', 'BLOCKED_SPAM', 'RATE_LIMITED', 'PERMISSION_DENIED', 'WEBHOOK_OK', 'WEBHOOK_FAILED', 'ERROR', 'SECURITY_ALERT'] &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 500)) &&
             (!('serverId' in data) || data.serverId == null || isValidId(data.serverId));
    }

    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 64 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 160)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 500)) &&
             (!('pronouns' in data) || data.pronouns == null || (data.pronouns is string && data.pronouns.size() <= 40)) &&
             (!('tag' in data) || data.tag == null || (data.tag is string && data.tag.size() <= 16)) &&
             (!('status' in data) || data.status == null || (data.status is string && data.status in ['ONLINE', 'IDLE', 'DO_NOT_DISTURB', 'OFFLINE'])) &&
             (!('customStatus' in data) || data.customStatus == null || (data.customStatus is string && data.customStatus.size() <= 160)) &&
             (!('lastActiveAtMs' in data) || data.lastActiveAtMs is int) &&
             (!('lastActivityLabel' in data) || data.lastActivityLabel == null || (data.lastActivityLabel is string && data.lastActivityLabel.size() <= 120)) &&
             (!('friendRequestPolicy' in data) || (data.friendRequestPolicy is string && data.friendRequestPolicy in ['EVERYONE', 'MUTUAL_SERVERS', 'NOBODY'])) &&
             (!('allowDmsFrom' in data) || (data.allowDmsFrom is string && data.allowDmsFrom in ['EVERYONE', 'FRIENDS_ONLY', 'MUTUAL_SERVERS'])) &&
             (!('showOnlineStatus' in data) || data.showOnlineStatus is bool) &&
             (!('showLastActivity' in data) || data.showLastActivity is bool) &&
             (!('notifyFriendRequests' in data) || data.notifyFriendRequests is bool) &&
             (!('clanTag' in data) || data.clanTag == null || (data.clanTag is string && data.clanTag.size() <= 8)) &&
             (!('fcmToken' in data) || data.fcmToken == null || (data.fcmToken is string && data.fcmToken.size() <= 512)) &&
             (!('orbsBalance' in data) || data.orbsBalance is int) &&
             (!('xp' in data) || data.xp is int) &&
             (!('level' in data) || data.level is int);
    }

    function isValidPublicProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 64 &&
             (!('tag' in data) || data.tag == null || (data.tag is string && data.tag.size() <= 16)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 500)) &&
             (!('status' in data) || data.status == null || (data.status is string && data.status in ['ONLINE', 'IDLE', 'DO_NOT_DISTURB', 'OFFLINE'])) &&
             (!('customStatus' in data) || data.customStatus == null || (data.customStatus is string && data.customStatus.size() <= 160)) &&
             (!('clanTag' in data) || data.clanTag == null || (data.clanTag is string && data.clanTag.size() <= 8)) &&
             (!('clanBadgeIcon' in data) || data.clanBadgeIcon == null || (data.clanBadgeIcon is string && data.clanBadgeIcon.size() <= 40)) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('avatarColor' in data) || data.avatarColor is int) &&
             (!('lastActiveAtMs' in data) || data.lastActiveAtMs is int) &&
             (!('lastActivityLabel' in data) || data.lastActivityLabel == null || (data.lastActivityLabel is string && data.lastActivityLabel.size() <= 120)) &&
             (!('friendRequestPolicy' in data) || (data.friendRequestPolicy is string && data.friendRequestPolicy in ['EVERYONE', 'MUTUAL_SERVERS', 'NOBODY'])) &&
             (!('allowDmsFrom' in data) || (data.allowDmsFrom is string && data.allowDmsFrom in ['EVERYONE', 'FRIENDS_ONLY', 'MUTUAL_SERVERS'])) &&
             (!('showOnlineStatus' in data) || data.showOnlineStatus is bool) &&
             (!('showLastActivity' in data) || data.showLastActivity is bool) &&
             (!('xp' in data) || data.xp is int) &&
             (!('level' in data) || data.level is int);
    }

    function isValidNotification(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.body is string && data.body.size() <= 500 &&
             (!('sourceLabel' in data) || data.sourceLabel == null || (data.sourceLabel is string && data.sourceLabel.size() <= 100)) &&
             (!('type' in data) || data.type == null || (data.type is string && data.type.size() <= 40)) &&
             (!('isRead' in data) || data.isRead is bool);
    }

    function isValidCommunityHandle(data) {
      return data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 40 &&
             data.serverId is string && isValidId(data.serverId) &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 80)) &&
             (!('isPublic' in data) || data.isPublic is bool);
    }

    function isValidCommunityInvite(data) {
      return data.code is string && isValidId(data.code) &&
             data.serverId is string && isValidId(data.serverId) &&
             data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
             data.isRevoked is bool &&
             (!('serverName' in data) || (data.serverName is string && data.serverName.size() <= 80)) &&
             (!('maxUses' in data) || (data.maxUses is int && data.maxUses >= 0)) &&
             (!('usesCount' in data) || (data.usesCount is int && data.usesCount >= 0)) &&
             (!('isPublic' in data) || data.isPublic is bool);
    }

    function isValidServer(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.memberIds is list && data.memberIds.size() >= 1 && data.memberIds.size() <= 200 &&
             (!('uniqueHandle' in data) || data.uniqueHandle == null || (data.uniqueHandle is string && data.uniqueHandle.size() <= 40)) &&
             (!('iconText' in data) || data.iconText == null || (data.iconText is string && data.iconText.size() <= 8)) &&
             (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 800)) &&
             (!('bannerUrl' in data) || data.bannerUrl == null || (data.bannerUrl is string && data.bannerUrl.size() <= 800)) &&
             (!('inviteCode' in data) || data.inviteCode == null || (data.inviteCode is string && data.inviteCode.size() <= 40)) &&
             (!('categoryTag' in data) || data.categoryTag == null || (data.categoryTag is string && data.categoryTag.size() <= 40)) &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500)) &&
             (!('rulesGuidelines' in data) || data.rulesGuidelines == null || (data.rulesGuidelines is string && data.rulesGuidelines.size() <= 1000)) &&
             (!('serverRulesList' in data) || (data.serverRulesList is list && data.serverRulesList.size() <= 40)) &&
             (!('homeWelcomeMessage' in data) || data.homeWelcomeMessage == null || (data.homeWelcomeMessage is string && data.homeWelcomeMessage.size() <= 500)) &&
             (!('verificationLevel' in data) || (data.verificationLevel is string && data.verificationLevel in ['NONE', 'LOW', 'MEDIUM', 'HIGH'])) &&
             (!('requireRulesAcceptance' in data) || data.requireRulesAcceptance is bool) &&
             (!('themeConfig' in data) || data.themeConfig is map) &&
             (!('welcomeConfig' in data) || data.welcomeConfig is map) &&
             (!('notificationConfig' in data) || data.notificationConfig is map) &&
             (!('moderationConfig' in data) || (data.moderationConfig is map && !('blockedWords' in data.moderationConfig))) &&
             (!('privacyConfig' in data) || data.privacyConfig is map) &&
             (!('adminIds' in data) || (data.adminIds is list && data.adminIds.size() <= 50)) &&
             (!('moderatorIds' in data) || (data.moderatorIds is list && data.moderatorIds.size() <= 100)) &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('isClosed' in data) || data.isClosed is bool) &&
             (!('closedByUid' in data) || data.closedByUid == null || (data.closedByUid is string && data.closedByUid.size() <= 128)) &&
             (!('closedByName' in data) || data.closedByName == null || (data.closedByName is string && data.closedByName.size() <= 64)) &&
             (!('closedAtMs' in data) || data.closedAtMs == null || data.closedAtMs is int) &&
             (!('boostCount' in data) || data.boostCount is int) &&
             (!('boostLevel' in data) || data.boostLevel is int);
    }

    function isValidAdminSecuritySettings(data, serverId) {
      return data.serverId == serverId &&
             data.settingType == 'security' &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             (!('verificationLevel' in data) || (data.verificationLevel is string && data.verificationLevel in ['NONE', 'LOW', 'MEDIUM', 'HIGH'])) &&
             (!('autoModEnabled' in data) || data.autoModEnabled is bool) &&
             (!('blockSpamAndLinks' in data) || data.blockSpamAndLinks is bool) &&
             (!('blockBadWords' in data) || data.blockBadWords is bool) &&
             (!('blockedWords' in data) || (data.blockedWords is list && data.blockedWords.size() <= 200)) &&
             (!('defaultSlowmodeSeconds' in data) || (data.defaultSlowmodeSeconds is int && data.defaultSlowmodeSeconds >= 0 && data.defaultSlowmodeSeconds <= 600)) &&
             (!('maxMentionsPerMessage' in data) || (data.maxMentionsPerMessage is int && data.maxMentionsPerMessage >= 1 && data.maxMentionsPerMessage <= 50)) &&
             (!('antiRaidModeEnabled' in data) || data.antiRaidModeEnabled is bool) &&
             (!('requireInviteApproval' in data) || data.requireInviteApproval is bool);
    }

    function isValidAdminPublicPolicy(data, serverId) {
      return data.serverId == serverId &&
             data.settingType == 'public_policy' &&
             data.updatedByUid is string && data.updatedByUid.size() >= 1 && data.updatedByUid.size() <= 128 &&
             (!('verificationLevel' in data) || (data.verificationLevel is string && data.verificationLevel in ['NONE', 'LOW', 'MEDIUM', 'HIGH'])) &&
             (!('requireRulesAcceptance' in data) || data.requireRulesAcceptance is bool) &&
             (!('serverRulesList' in data) || (data.serverRulesList is list && data.serverRulesList.size() <= 40)) &&
             (!('discoverableInCatalog' in data) || data.discoverableInCatalog is bool) &&
             (!('allowInviteLinks' in data) || data.allowInviteLinks is bool) &&
             (!('allowMemberDms' in data) || data.allowMemberDms is bool) &&
             (!('hideMemberListForNonStaff' in data) || data.hideMemberListForNonStaff is bool);
    }

    function isValidCommunityMember(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.serverId is string && isValidId(data.serverId) &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 64 &&
             data.role is string && data.role in ['ADMIN', 'MODERATOR', 'MEMBER', 'BOT'] &&
             (!('customRoleId' in data) || data.customRoleId == null || (data.customRoleId is string && data.customRoleId.size() <= 128)) &&
             (!('permissions' in data) || (data.permissions is list && data.permissions.size() <= 30)) &&
             (!('status' in data) || (data.status is string && data.status in ['ONLINE', 'IDLE', 'DND', 'OFFLINE'])) &&
             (!('isTimedOut' in data) || data.isTimedOut is bool) &&
             (!('isPublic' in data) || data.isPublic is bool);
    }

    function isValidAnnouncement(data) {
      return data.serverId is string && isValidId(data.serverId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             (!('isPinned' in data) || data.isPinned is bool) &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('memberIds' in data) || (data.memberIds is list && data.memberIds.size() <= 200));
    }

    function isValidCommunityEvent(data) {
      return data.serverId is string && isValidId(data.serverId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 600)) &&
             (!('interestedUserIds' in data) || (data.interestedUserIds is list && data.interestedUserIds.size() <= 200)) &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('memberIds' in data) || (data.memberIds is list && data.memberIds.size() <= 200));
    }

    function isValidChannel(data) {
      return data.serverId is string && data.serverId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.type is string && data.type in ['TEXT', 'VOICE', 'ANNOUNCEMENT', 'STAGE'] &&
             data.memberIds is list && data.memberIds.size() <= 200 &&
             (!('position' in data) || (data.position is int && data.position >= 0 && data.position <= 500)) &&
             (!('iconKey' in data) || data.iconKey == null || (data.iconKey is string && data.iconKey.size() <= 32)) &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('isPrivate' in data) || data.isPrivate is bool) &&
             (!('isLocked' in data) || data.isLocked is bool) &&
             (!('maxParticipants' in data) || (data.maxParticipants is int && data.maxParticipants >= 0 && data.maxParticipants <= 100)) &&
             (!('bitrateKbps' in data) || (data.bitrateKbps is int && data.bitrateKbps >= 8 && data.bitrateKbps <= 384)) &&
             (!('allowedRoles' in data) || (data.allowedRoles is list && data.allowedRoles.size() <= 20)) &&
             (!('allowedRoleIds' in data) || (data.allowedRoleIds is list && data.allowedRoleIds.size() <= 50)) &&
             (!('kickedVoiceUids' in data) || (data.kickedVoiceUids is list && data.kickedVoiceUids.size() <= 100)) &&
             (!('slowmodeSeconds' in data) || data.slowmodeSeconds is int) &&
             (!('isReadOnly' in data) || data.isReadOnly is bool) &&
             (!('lastTypingUid' in data) || data.lastTypingUid == null || (data.lastTypingUid is string && data.lastTypingUid.size() <= 128)) &&
             (!('lastTypingName' in data) || data.lastTypingName == null || (data.lastTypingName is string && data.lastTypingName.size() <= 64));
    }

    function isValidMessage(data) {
      return data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 64 &&
             (!('text' in data) || data.text == null || (data.text is string && data.text.size() <= 2000)) &&
             (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 800)) &&
             (!('audioUrl' in data) || data.audioUrl == null || (data.audioUrl is string && data.audioUrl.size() <= 800)) &&
             (!('attachmentName' in data) || data.attachmentName == null || (data.attachmentName is string && data.attachmentName.size() <= 200)) &&
             (!('stickerId' in data) || data.stickerId == null || (data.stickerId is string && data.stickerId.size() <= 80)) &&
             (!('replyToText' in data) || data.replyToText == null || (data.replyToText is string && data.replyToText.size() <= 200)) &&
             (!('isPinned' in data) || data.isPinned is bool) &&
             (!('isEdited' in data) || data.isEdited is bool) &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('isBotMessage' in data) || data.isBotMessage is bool) &&
             (!('botId' in data) || data.botId == null || isValidId(data.botId)) &&
             (!('triggeredByUid' in data) || data.triggeredByUid == null || (data.triggeredByUid is string && data.triggeredByUid.size() <= 128)) &&
             (!('poll' in data) || data.poll == null || data.poll is map) &&
             (!('botQuickReplies' in data) || (data.botQuickReplies is list && data.botQuickReplies.size() <= 10)) &&
             (!('memberIds' in data) || (data.memberIds is list && data.memberIds.size() <= 200)) &&
             (!('participantIds' in data) || (data.participantIds is list && data.participantIds.size() <= 50));
    }

    function isValidWhiteboard(data) {
      return data.serverId is string && data.serverId.size() <= 128 &&
             data.updatedBy is string && data.updatedBy.size() <= 128 &&
             data.memberIds is list && data.memberIds.size() <= 200 &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('strokes' in data) || (data.strokes is list && data.strokes.size() <= 150));
    }

    function isValidJukebox(data) {
      return data.serverId is string && data.serverId.size() <= 128 &&
             data.updatedBy is string && data.updatedBy.size() <= 128 &&
             data.isPlaying is bool &&
             data.memberIds is list && data.memberIds.size() <= 200 &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('elapsedSec' in data) || data.elapsedSec is int);
    }

    function isValidVoicePeer(data) {
      return data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64 &&
             data.memberIds is list && data.memberIds.size() <= 200 &&
             (!('isPublic' in data) || data.isPublic is bool) &&
             (!('isMuted' in data) || data.isMuted is bool) &&
             (!('isDeafened' in data) || data.isDeafened is bool) &&
             (!('isCameraOn' in data) || data.isCameraOn is bool) &&
             (!('isScreenSharing' in data) || data.isScreenSharing is bool) &&
             (!('isSpeaking' in data) || data.isSpeaking is bool) &&
             (!('connectionState' in data) || (data.connectionState is string && data.connectionState.size() <= 40)) &&
             (!('reconnectAttempt' in data) || (data.reconnectAttempt is int && data.reconnectAttempt >= 0 && data.reconnectAttempt <= 20));
    }

    function canJoinVoiceChannel(serverId, channelId) {
      return isServerMemberOrPublic(serverId) && (
        isCommunityStaff(serverId) ||
        !exists(/databases/$(database)/documents/servers/$(serverId)/channels/$(channelId)) ||
        (
          (!('isLocked' in get(/databases/$(database)/documents/servers/$(serverId)/channels/$(channelId)).data) ||
           get(/databases/$(database)/documents/servers/$(serverId)/channels/$(channelId)).data.isLocked == false) &&
          (!('kickedVoiceUids' in get(/databases/$(database)/documents/servers/$(serverId)/channels/$(channelId)).data) ||
           !(request.auth.uid in get(/databases/$(database)/documents/servers/$(serverId)/channels/$(channelId)).data.kickedVoiceUids))
        )
      );
    }

    function isValidRtcSignal(data) {
      return data.fromUid is string && data.fromUid.size() >= 1 && data.fromUid.size() <= 128 &&
             data.toUid is string && data.toUid.size() >= 1 && data.toUid.size() <= 128 &&
             data.type is string && data.type in ['OFFER', 'ANSWER', 'ICE'] &&
             data.payload is string && data.payload.size() <= 16000;
    }

    function canonicalPairId(uidA, uidB) {
      return uidA <= uidB ? (uidA + '__' + uidB) : (uidB + '__' + uidA);
    }

    function isUserBlockedBy(targetUid, actorUid) {
      return exists(/databases/$(database)/documents/users/$(targetUid)/blocked_users/$(actorUid));
    }

    function hasNoBlockBetween(uidA, uidB) {
      return !isUserBlockedBy(uidA, uidB) && !isUserBlockedBy(uidB, uidA);
    }

    function areAlreadyFriends(uidA, uidB) {
      return exists(/databases/$(database)/documents/users/$(uidA)/friends/$(uidB)) ||
             exists(/databases/$(database)/documents/users/$(uidB)/friends/$(uidA));
    }

    function publicProfileExists(uid) {
      return exists(/databases/$(database)/documents/public_profiles/$(uid));
    }

    function publicProfileDoc(uid) {
      return get(/databases/$(database)/documents/public_profiles/$(uid));
    }

    function hasMutualServer(uidA, uidB, serverId) {
      return serverId is string && isValidId(serverId) && serverExists(serverId) &&
             (serverDoc(serverId).data.ownerId == uidA || uidA in serverDoc(serverId).data.memberIds) &&
             (serverDoc(serverId).data.ownerId == uidB || uidB in serverDoc(serverId).data.memberIds);
    }

    function recipientAllowsFriendRequest(fromUid, toUid, data) {
      return !publicProfileExists(toUid) ||
             !('friendRequestPolicy' in publicProfileDoc(toUid).data) ||
             publicProfileDoc(toUid).data.friendRequestPolicy == 'EVERYONE' ||
             (publicProfileDoc(toUid).data.friendRequestPolicy == 'MUTUAL_SERVERS' &&
              ('sharedServerId' in data) && data.sharedServerId != null &&
              hasMutualServer(fromUid, toUid, data.sharedServerId));
    }

    function isValidFriendDoc(data, ownerUid, friendUid) {
      return data.friendUid == friendUid &&
             friendUid != ownerUid &&
             isValidId(friendUid) &&
             data.pairId == canonicalPairId(ownerUid, friendUid) &&
             data.friendName is string && data.friendName.size() >= 1 && data.friendName.size() <= 64 &&
             (!('friendTag' in data) || (data.friendTag is string && data.friendTag.size() <= 16)) &&
             (!('avatarColor' in data) || data.avatarColor is int) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('status' in data) || (data.status is string && data.status in ['ONLINE', 'IDLE', 'DO_NOT_DISTURB', 'OFFLINE'])) &&
             (!('customStatus' in data) || (data.customStatus is string && data.customStatus.size() <= 160)) &&
             (!('lastActiveAtMs' in data) || data.lastActiveAtMs is int) &&
             (!('lastActivityLabel' in data) || (data.lastActivityLabel is string && data.lastActivityLabel.size() <= 120)) &&
             (!('privateNote' in data) || (data.privateNote is string && data.privateNote.size() <= 400)) &&
             (!('addedAtMs' in data) || data.addedAtMs is int);
    }

    function isValidBlockedDoc(data, ownerUid, blockedUid) {
      return data.blockedUid == blockedUid &&
             blockedUid != ownerUid &&
             isValidId(blockedUid) &&
             data.blockedByUid == ownerUid &&
             (!('name' in data) || (data.name is string && data.name.size() <= 64)) &&
             (!('tag' in data) || (data.tag is string && data.tag.size() <= 16)) &&
             (!('avatarColor' in data) || data.avatarColor is int) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 500)) &&
             (!('blockedAtMs' in data) || data.blockedAtMs is int);
    }

    function isValidFriendRequestDoc(data, requestId) {
      return data.id == requestId &&
             data.pairId == requestId &&
             data.fromUid is string && isValidId(data.fromUid) &&
             data.toUid is string && isValidId(data.toUid) &&
             data.fromUid != data.toUid &&
             requestId == canonicalPairId(data.fromUid, data.toUid) &&
             data.participantIds is list &&
             data.participantIds.size() == 2 &&
             data.fromUid in data.participantIds &&
             data.toUid in data.participantIds &&
             data.status is string && data.status in ['PENDING', 'ACCEPTED', 'DECLINED', 'CANCELLED'] &&
             data.fromName is string && data.fromName.size() >= 1 && data.fromName.size() <= 64 &&
             data.toName is string && data.toName.size() >= 1 && data.toName.size() <= 64 &&
             (!('fromTag' in data) || (data.fromTag is string && data.fromTag.size() <= 16)) &&
             (!('toTag' in data) || (data.toTag is string && data.toTag.size() <= 16)) &&
             (!('fromAvatarColor' in data) || data.fromAvatarColor is int) &&
             (!('toAvatarColor' in data) || data.toAvatarColor is int) &&
             (!('fromAvatarUrl' in data) || data.fromAvatarUrl == null || (data.fromAvatarUrl is string && data.fromAvatarUrl.size() <= 500)) &&
             (!('toAvatarUrl' in data) || data.toAvatarUrl == null || (data.toAvatarUrl is string && data.toAvatarUrl.size() <= 500)) &&
             (!('sharedServerId' in data) || data.sharedServerId == null || isValidId(data.sharedServerId)) &&
             (!('createdAtMs' in data) || data.createdAtMs is int) &&
             (!('updatedAtMs' in data) || data.updatedAtMs is int);
    }

    function recipientAllowsDmFrom(senderUid, targetUid) {
      return targetUid == senderUid ||
             !publicProfileExists(targetUid) ||
             !('allowDmsFrom' in publicProfileDoc(targetUid).data) ||
             publicProfileDoc(targetUid).data.allowDmsFrom != 'FRIENDS_ONLY' ||
             areAlreadyFriends(senderUid, targetUid);
    }

    function twoPartyDmNoBlock(participants) {
      return participants.size() != 2 || hasNoBlockBetween(participants[0], participants[1]);
    }

    function twoPartyDmCreateAllowed(participants) {
      return participants.size() != 2 || (
        hasNoBlockBetween(participants[0], participants[1]) &&
        recipientAllowsDmFrom(request.auth.uid, participants[0]) &&
        recipientAllowsDmFrom(request.auth.uid, participants[1])
      );
    }

    function isValidDirectConversation(data) {
      return data.participantIds is list && data.participantIds.size() >= 1 && data.participantIds.size() <= 25 &&
             (!('id' in data) || isValidId(data.id)) &&
             (!('dmPairKey' in data) || data.dmPairKey == null || isValidId(data.dmPairKey)) &&
              (!('isGroup' in data) || data.isGroup is bool) &&
              (!('isBotChat' in data) || data.isBotChat is bool) &&
              (!('botId' in data) || data.botId == null || isValidId(data.botId)) &&
              (!('groupName' in data) || data.groupName == null || (data.groupName is string && data.groupName.size() <= 80)) &&
              (!('participantNames' in data) || data.participantNames is map) &&
              (!('updatedAtMs' in data) || data.updatedAtMs is int) &&
              (!('lastMessage' in data) || data.lastMessage == null || (data.lastMessage is string && data.lastMessage.size() <= 500)) &&
              (!('lastMessageTime' in data) || data.lastMessageTime == null || (data.lastMessageTime is string && data.lastMessageTime.size() <= 40));
    }

    function storyDoc(storyId) {
      return get(/databases/$(database)/documents/stories/$(storyId));
    }

    function storyExists(storyId) {
      return exists(/databases/$(database)/documents/stories/$(storyId));
    }

    function canViewStoryDoc(data) {
      return data.authorId == request.auth.uid ||
             data.visibility == 'PUBLIC' ||
             (('allowedViewerIds' in data) && request.auth.uid in data.allowedViewerIds);
    }

    function isValidStoryUrl(url) {
      return url is string &&
             url.size() >= 1 &&
             url.size() <= 900 &&
             !url.matches('.*javascript:.*') &&
             !url.matches('.*\\.\\..*');
    }

    function isValidStoryDoc(data) {
      return data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 64 &&
             data.mediaType is string && data.mediaType in ['TEXT', 'IMAGE', 'VIDEO'] &&
             data.visibility is string && data.visibility in ['PUBLIC', 'FRIENDS', 'CUSTOM_USERS'] &&
             data.durationHours is int && data.durationHours >= 1 && data.durationHours <= 168 &&
             data.createdAtMs is int && data.expiresAtMs is int && data.expiresAtMs > data.createdAtMs &&
             data.viewCount is int && data.viewCount >= 0 &&
             (
               (data.mediaType == 'TEXT' && 'textContent' in data && data.textContent is string && data.textContent.size() >= 1 && data.textContent.size() <= 500) ||
               (data.mediaType in ['IMAGE', 'VIDEO'] && 'mediaUrl' in data && isValidStoryUrl(data.mediaUrl))
             ) &&
             (!('authorAvatarUrl' in data) || data.authorAvatarUrl == null || (data.authorAvatarUrl is string && data.authorAvatarUrl.size() <= 800)) &&
             (!('authorAvatarColor' in data) || data.authorAvatarColor is int) &&
             (!('mediaUrl' in data) || data.mediaUrl == null || isValidStoryUrl(data.mediaUrl)) &&
             (!('thumbnailUrl' in data) || data.thumbnailUrl == null || isValidStoryUrl(data.thumbnailUrl)) &&
             (!('mediaMimeType' in data) || data.mediaMimeType == null || (data.mediaMimeType is string && data.mediaMimeType.size() <= 64)) &&
             (!('mediaSizeBytes' in data) || (data.mediaSizeBytes is int && data.mediaSizeBytes >= 0 && data.mediaSizeBytes <= 52428800)) &&
             (!('textContent' in data) || (data.textContent is string && data.textContent.size() <= 500)) &&
             (!('caption' in data) || (data.caption is string && data.caption.size() <= 300)) &&
             (!('allowedViewerIds' in data) || (data.allowedViewerIds is list && data.allowedViewerIds.size() <= 200)) &&
             (!('viewerIds' in data) || (data.viewerIds is list && data.viewerIds.size() <= 500)) &&
             (!('likedByIds' in data) || (data.likedByIds is list && data.likedByIds.size() <= 1000)) &&
             (!('likesCount' in data) || (data.likesCount is int && data.likesCount >= 0));
    }

    function isValidStoryView(data, storyId) {
      return data.viewerId is string && data.viewerId.size() >= 1 && data.viewerId.size() <= 128 &&
             data.storyId == storyId &&
             data.viewerName is string && data.viewerName.size() >= 1 && data.viewerName.size() <= 64 &&
             (!('authorId' in data) || (data.authorId is string && data.authorId.size() <= 128)) &&
             (!('viewerAvatarUrl' in data) || data.viewerAvatarUrl == null || (data.viewerAvatarUrl is string && data.viewerAvatarUrl.size() <= 800)) &&
             (!('viewerAvatarColor' in data) || data.viewerAvatarColor is int) &&
             (!('viewedAtMs' in data) || data.viewedAtMs is int);
    }

    function pollDoc(pollId) {
      return get(/databases/$(database)/documents/polls/$(pollId));
    }

    function pollExists(pollId) {
      return exists(/databases/$(database)/documents/polls/$(pollId));
    }

    function isValidPollDoc(data, pollId) {
      return data.id == pollId &&
             isValidId(pollId) &&
             data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 64 &&
             data.question is string && data.question.size() >= 3 && data.question.size() <= 300 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             data.options is list && data.options.size() >= 2 && data.options.size() <= 10 &&
             data.optionCounts is map &&
             data.optionCounts.keys().size() == data.options.size() &&
             data.optionCounts.keys().hasOnly(['opt_0', 'opt_1', 'opt_2', 'opt_3', 'opt_4', 'opt_5', 'opt_6', 'opt_7', 'opt_8', 'opt_9']) &&
             data.allowsMultiple is bool &&
             data.maxChoices is int && data.maxChoices >= 1 && data.maxChoices <= 10 &&
             (data.allowsMultiple == true || data.maxChoices == 1) &&
             data.allowVoteChange is bool &&
             data.isAnonymous is bool &&
             data.visibility is string && data.visibility in ['PUBLIC', 'SERVER', 'ROLE_RESTRICTED'] &&
             data.status is string && data.status in ['DRAFT', 'PUBLISHED', 'CLOSED'] &&
             data.isPublic is bool &&
             ((data.status == 'DRAFT' && data.isPublic == false && (!('memberIds' in data) || data.memberIds.size() == 0)) ||
              (data.status != 'DRAFT' && data.isPublic == (data.visibility == 'PUBLIC'))) &&
             data.durationMinutes is int && data.durationMinutes >= 0 && data.durationMinutes <= 525600 &&
             data.totalVotes is int && data.totalVotes >= 0 &&
             data.totalVoters is int && data.totalVoters >= 0 &&
             (!('expiresAtMs' in data) || data.expiresAtMs == null || data.expiresAtMs is int) &&
             (!('publishedAtMs' in data) || data.publishedAtMs == null || data.publishedAtMs is int) &&
             (!('closedAtMs' in data) || data.closedAtMs == null || data.closedAtMs is int) &&
             (!('serverId' in data) || data.serverId == null || isValidId(data.serverId)) &&
             (!('channelId' in data) || data.channelId == null || isValidId(data.channelId)) &&
             (!('allowedRoleIds' in data) || (data.allowedRoleIds is list && data.allowedRoleIds.size() <= 30)) &&
             (!('allowedRoleNames' in data) || (data.allowedRoleNames is list && data.allowedRoleNames.size() <= 30)) &&
             (!('memberIds' in data) || (data.memberIds is list && data.memberIds.size() <= 200)) &&
             (data.visibility != 'SERVER' || (('serverId' in data) && data.serverId != null)) &&
             (data.visibility != 'ROLE_RESTRICTED' ||
              (('serverId' in data) && data.serverId != null && ('allowedRoleIds' in data) && data.allowedRoleIds.size() >= 1));
    }

    function hasAllowedPollRole(serverId, allowedRoles) {
      let srv = get(/databases/$(database)/documents/servers/$(serverId)).data;
      let memExists = exists(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid));
      let mem = memExists ? get(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)).data : {};
      return (srv.ownerId == request.auth.uid && ('ADMIN' in allowedRoles || 'role_admin' in allowedRoles)) ||
             (('adminIds' in srv) && request.auth.uid in srv.adminIds && ('ADMIN' in allowedRoles || 'role_admin' in allowedRoles)) ||
             (('moderatorIds' in srv) && request.auth.uid in srv.moderatorIds && ('MODERATOR' in allowedRoles || 'role_mod' in allowedRoles)) ||
             ('role' in mem && (
               mem.role in allowedRoles ||
               ('MEMBER' in allowedRoles && mem.role in ['MEMBER', 'MODERATOR', 'ADMIN']) ||
               ('role_member' in allowedRoles && mem.role == 'MEMBER')
             )) ||
             (('customRoleId' in mem) && mem.customRoleId != null && mem.customRoleId in allowedRoles);
    }

    function isEligiblePollVoter(poll) {
      return poll.visibility == 'PUBLIC' ||
             (poll.visibility == 'SERVER' && ('serverId' in poll) && poll.serverId != null && isServerMemberOrPublic(poll.serverId)) ||
             (poll.visibility == 'ROLE_RESTRICTED' && ('serverId' in poll) && poll.serverId != null &&
              isServerMemberOrPublic(poll.serverId) && ('allowedRoleIds' in poll) &&
              hasAllowedPollRole(poll.serverId, poll.allowedRoleIds));
    }

    function isValidVoteDoc(data, pollId, poll) {
      return data.pollId == pollId &&
             data.voterId == request.auth.uid &&
             data.voterName is string && data.voterName.size() >= 1 && data.voterName.size() <= 64 &&
             (poll.isAnonymous == false || data.voterName == 'Anonyme') &&
             data.selectedOptionIds is list &&
             data.selectedOptionIds.size() >= 1 &&
             data.selectedOptionIds.size() <= poll.maxChoices &&
             (poll.allowsMultiple == true || data.selectedOptionIds.size() == 1) &&
             data.selectedOptionIds.toSet().size() == data.selectedOptionIds.size() &&
             poll.optionCounts.keys().hasAll(data.selectedOptionIds);
    }

    function slotOk(k, beforeSel, afterSel, oldC, newC) {
      return !(k in oldC) || (
        newC[k] is int && newC[k] >= 0 &&
        newC[k] == oldC[k] + (k in afterSel ? 1 : 0) - (k in beforeSel ? 1 : 0)
      );
    }

    function validPollTallyUpdate(pollId, oldPoll, newPoll) {
      let votePath = /databases/$(database)/documents/polls/$(pollId)/votes/$(request.auth.uid);
      let voteBefore = exists(votePath);
      let voteAfter = existsAfter(votePath);
      let beforeSel = voteBefore ? get(votePath).data.selectedOptionIds : [];
      let afterSel = voteAfter ? getAfter(votePath).data.selectedOptionIds : [];
      let oldC = oldPoll.optionCounts;
      let newC = newPoll.optionCounts;
      return (voteBefore || voteAfter) &&
             (!voteBefore || oldPoll.allowVoteChange == true) &&
             newPoll.totalVotes is int && newPoll.totalVotes >= 0 &&
             newPoll.totalVoters is int && newPoll.totalVoters >= 0 &&
             newPoll.totalVoters == oldPoll.totalVoters + (voteAfter ? 1 : 0) - (voteBefore ? 1 : 0) &&
             newPoll.totalVotes == oldPoll.totalVotes - beforeSel.size() + afterSel.size() &&
             slotOk('opt_0', beforeSel, afterSel, oldC, newC) &&
             slotOk('opt_1', beforeSel, afterSel, oldC, newC) &&
             slotOk('opt_2', beforeSel, afterSel, oldC, newC) &&
             slotOk('opt_3', beforeSel, afterSel, oldC, newC) &&
             slotOk('opt_4', beforeSel, afterSel, oldC, newC) &&
             slotOk('opt_5', beforeSel, afterSel, oldC, newC) &&
             slotOk('opt_6', beforeSel, afterSel, oldC, newC) &&
             slotOk('opt_7', beforeSel, afterSel, oldC, newC) &&
             slotOk('opt_8', beforeSel, afterSel, oldC, newC) &&
             slotOk('opt_9', beforeSel, afterSel, oldC, newC);
    }

    function canReadPollVotes(pollId) {
      let p = pollDoc(pollId).data;
      return pollExists(pollId) &&
             p.isAnonymous == false &&
             p.status != 'DRAFT' && (
               p.isPublic == true ||
               (('serverId' in p) && p.serverId != null && isServerMemberOrPublic(p.serverId)) ||
               (('memberIds' in p) && request.auth.uid in p.memberIds)
             );
    }

    function canWriteVote(pollId, voteId, isCreate) {
      let p = pollDoc(pollId).data;
      let pAfter = getAfter(/databases/$(database)/documents/polls/$(pollId)).data;
      return isValidId(voteId) && voteId == request.auth.uid &&
             pollExists(pollId) &&
             p.status == 'PUBLISHED' &&
             (isCreate || p.allowVoteChange == true) &&
             (!('expiresAtMs' in p) || p.expiresAtMs == null || request.time.toMillis() <= p.expiresAtMs) &&
             isEligiblePollVoter(p) &&
             isValidVoteDoc(incoming(), pollId, p) &&
             pAfter.totalVoters == p.totalVoters + (isCreate ? 1 : 0);
    }

    function canDeleteVote(pollId, voteId) {
      let p = pollDoc(pollId).data;
      let pAfter = getAfter(/databases/$(database)/documents/polls/$(pollId)).data;
      return isValidId(voteId) && voteId == request.auth.uid &&
             existing().voterId == request.auth.uid &&
             pollExists(pollId) &&
             p.status == 'PUBLISHED' &&
             p.allowVoteChange == true &&
             (!('expiresAtMs' in p) || p.expiresAtMs == null || request.time.toMillis() <= p.expiresAtMs) &&
             pAfter.totalVoters == p.totalVoters - 1;
    }

    function eventDoc(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId));
    }

    function eventExists(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId));
    }

    function canManageServerEvents(serverId) {
      return isCommunityStaff(serverId) || (
        serverExists(serverId) &&
        exists(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)) &&
        'permissions' in get(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)).data &&
        'MANAGE_EVENTS' in get(/databases/$(database)/documents/servers/$(serverId)/members/$(request.auth.uid)).data.permissions
      );
    }

    function canManageRavenEvent(data) {
      return data.creatorId == request.auth.uid ||
             (('serverId' in data) && data.serverId != null && canManageServerEvents(data.serverId));
    }

    function canViewRavenEvent(data) {
      return data.creatorId == request.auth.uid ||
             data.isPublic == true ||
             (('invitedUserIds' in data) && request.auth.uid in data.invitedUserIds) ||
             (('memberIds' in data) && request.auth.uid in data.memberIds) ||
             (('serverId' in data) && data.serverId != null && data.visibility != 'PRIVATE_INVITE' && isServerMemberOrPublic(data.serverId));
    }

    function isValidEventImage(url) {
      return url is string &&
             url.size() >= 1 &&
             url.size() <= 900 &&
             !url.matches('.*javascript:.*') &&
             !url.matches('.*data:.*') &&
             !url.matches('.*\\.\\..*');
    }

    function isValidRavenEvent(data, eventId) {
      return data.id == eventId &&
             isValidId(eventId) &&
             data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
             data.creatorName is string && data.creatorName.size() >= 1 && data.creatorName.size() <= 64 &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1500)) &&
             (!('imageUrl' in data) || data.imageUrl == null || isValidEventImage(data.imageUrl)) &&
             (!('bannerColorHex' in data) || data.bannerColorHex is int) &&
             data.eventType is string && data.eventType in ['VOICE', 'SERVER', 'EXTERNAL'] &&
             data.visibility is string && data.visibility in ['PUBLIC', 'SERVER', 'PRIVATE_INVITE'] &&
             data.isPublic is bool &&
             data.isPublic == (data.visibility == 'PUBLIC') &&
             data.status is string && data.status in ['SCHEDULED', 'ONGOING', 'COMPLETED', 'CANCELLED'] &&
             data.startAtMs is int && data.startAtMs > 0 &&
             data.durationMinutes is int && data.durationMinutes >= 5 && data.durationMinutes <= 10080 &&
             data.timezoneId is string && data.timezoneId.size() >= 2 && data.timezoneId.size() <= 64 &&
             (!('location' in data) || (data.location is string && data.location.size() <= 240)) &&
             (!('serverId' in data) || data.serverId == null || isValidId(data.serverId)) &&
             (!('voiceChannelId' in data) || data.voiceChannelId == null || isValidId(data.voiceChannelId)) &&
             data.maxParticipants is int && data.maxParticipants >= 0 && data.maxParticipants <= 1000 &&
             data.goingIds is list && data.goingIds.size() <= 500 &&
             data.interestedIds is list && data.interestedIds.size() <= 500 &&
             data.waitlistIds is list && data.waitlistIds.size() <= 500 &&
             data.invitedUserIds is list && data.invitedUserIds.size() <= 200 &&
             data.memberIds is list && data.memberIds.size() <= 200 &&
             (data.visibility != 'PRIVATE_INVITE' || data.memberIds.size() == 0) &&
             (data.visibility != 'SERVER' || (('serverId' in data) && data.serverId != null)) &&
             (data.maxParticipants == 0 || data.goingIds.size() <= data.maxParticipants);
    }

    function validEventRsvpUpdate(oldEv, newEv) {
      return oldEv.status == 'SCHEDULED' &&
             newEv.status == 'SCHEDULED' &&
             newEv.diff(oldEv).affectedKeys().hasOnly(['goingIds', 'interestedIds', 'waitlistIds', 'updatedAtMs', 'updatedAt']) &&
             newEv.goingIds is list && newEv.goingIds.size() <= 500 &&
             newEv.interestedIds is list && newEv.interestedIds.size() <= 500 &&
             newEv.waitlistIds is list && newEv.waitlistIds.size() <= 500 &&
             (newEv.interestedIds == oldEv.interestedIds || (
               newEv.interestedIds.toSet().difference(oldEv.interestedIds.toSet()).hasOnly([request.auth.uid]) &&
               oldEv.interestedIds.toSet().difference(newEv.interestedIds.toSet()).hasOnly([request.auth.uid])
             )) &&
             (!(request.auth.uid in newEv.waitlistIds) ||
              (request.auth.uid in oldEv.waitlistIds) ||
              (oldEv.maxParticipants > 0 && newEv.goingIds.size() >= oldEv.maxParticipants)) &&
             (
               (newEv.goingIds == oldEv.goingIds &&
                (newEv.waitlistIds == oldEv.waitlistIds || (
                  newEv.waitlistIds.toSet().difference(oldEv.waitlistIds.toSet()).hasOnly([request.auth.uid]) &&
                  oldEv.waitlistIds.toSet().difference(newEv.waitlistIds.toSet()).hasOnly([request.auth.uid])
                ))) ||
               (
                 oldEv.goingIds.toSet().difference(newEv.goingIds.toSet()).hasOnly([request.auth.uid]) &&
                 newEv.goingIds.toSet().difference(oldEv.goingIds.toSet()).hasOnly([request.auth.uid]) &&
                 (newEv.waitlistIds == oldEv.waitlistIds || (
                   newEv.waitlistIds.toSet().difference(oldEv.waitlistIds.toSet()).hasOnly([request.auth.uid]) &&
                   oldEv.waitlistIds.toSet().difference(newEv.waitlistIds.toSet()).hasOnly([request.auth.uid])
                 )) &&
                 (!(request.auth.uid in newEv.goingIds) ||
                  (request.auth.uid in oldEv.goingIds) ||
                  oldEv.maxParticipants == 0 ||
                  oldEv.goingIds.size() < oldEv.maxParticipants)
               ) ||
               (
                 (request.auth.uid in oldEv.goingIds) &&
                 !(request.auth.uid in newEv.goingIds) &&
                 oldEv.waitlistIds.size() > 0 &&
                 oldEv.goingIds.toSet().difference(newEv.goingIds.toSet()).hasOnly([request.auth.uid]) &&
                 newEv.goingIds.toSet().difference(oldEv.goingIds.toSet()).hasOnly([oldEv.waitlistIds[0]]) &&
                 newEv.waitlistIds.toSet().difference(oldEv.waitlistIds.toSet()).size() == 0 &&
                 oldEv.waitlistIds.toSet().difference(newEv.waitlistIds.toSet()).hasOnly([request.auth.uid, oldEv.waitlistIds[0]])
               )
             );
    }

    function isValidPluginId(id) {
      return id is string && id.size() >= 3 && id.size() <= 64 &&
             id.matches('^[a-z0-9][a-z0-9._\\-]{2,63}$');
    }

    function isValidSemVer(v) {
      return v is string && v.size() >= 3 && v.size() <= 24 &&
             v.matches('^[0-9]+\\.[0-9]+(\\.[0-9]+)?$');
    }

    function isValidPluginPermissionList(perms) {
      return perms is list && perms.size() <= 8 &&
             perms.hasOnly([
               'READ_ACTIVE_USER_PUBLIC',
               'READ_SERVER_METADATA',
               'MANAGE_UI_WIDGET',
               'LISTEN_APP_EVENTS',
               'EXECUTE_SLASH_COMMAND',
               'SEND_NOTIFICATIONS',
               'READ_MESSAGES_SUMMARY',
               'POST_CHANNEL_MESSAGE'
             ]);
    }

    function isValidUserPluginState(data, pluginId) {
      return isValidPluginId(pluginId) &&
             data.pluginId == pluginId &&
             isValidSemVer(data.installedVersion) &&
             data.isEnabled is bool &&
             data.lifecycleState in ['REGISTERED', 'INCOMPATIBLE', 'DISABLED', 'ACTIVE', 'FAULTED'] &&
             !(data.isEnabled == true && data.lifecycleState in ['INCOMPATIBLE', 'FAULTED', 'DISABLED']) &&
             isValidPluginPermissionList(data.grantedPermissions) &&
             isValidPluginPermissionList(data.deniedPermissions) &&
             data.grantedPermissions.toSet().intersection(data.deniedPermissions.toSet()).size() == 0 &&
             data.configValues is map && data.configValues.size() <= 20 &&
             !data.configValues.keys().hasAny(['dexUrl', 'jarUrl', 'soUrl', 'apkUrl', 'remoteScript', 'code']) &&
             !('dexUrl' in data) && !('jarUrl' in data) && !('remoteCode' in data) && !('scriptUrl' in data) &&
             data.consecutiveErrors is int && data.consecutiveErrors >= 0 && data.consecutiveErrors <= 10 &&
             (!('lastErrorMessage' in data) || data.lastErrorMessage == null || (data.lastErrorMessage is string && data.lastErrorMessage.size() <= 400)) &&
             data.updatedAtMs is int;
    }

    function isValidPluginLog(data, logId) {
      return isValidId(logId) &&
             data.id == logId &&
             isValidPluginId(data.pluginId) &&
             data.pluginName is string && data.pluginName.size() >= 1 && data.pluginName.size() <= 60 &&
             data.level in ['INFO', 'WARN', 'ERROR', 'SECURITY'] &&
             data.action is string && data.action.size() >= 1 && data.action.size() <= 64 &&
             data.message is string && data.message.size() <= 500 &&
             !data.message.matches('.*(\\.dex|\\.jar|\\.so|javascript:|eval\\().*') &&
             data.timestampMs is int && data.timestampMs > 0 &&
             (!('timestampLabel' in data) || (data.timestampLabel is string && data.timestampLabel.size() <= 32));
    }

    function isValidSearchHistoryEntry(data, userId, entryId) {
      return isValidId(entryId) &&
             data.id == entryId &&
             data.userId == userId &&
             data.query is string && data.query.size() >= 1 && data.query.size() <= 120 &&
             data.selectedTypeName is string &&
             data.selectedTypeName in ['ALL', 'USER', 'SERVER', 'COMMUNITY', 'CHANNEL', 'MESSAGE', 'CONVERSATION', 'EVENT', 'STORY', 'BOT', 'MARKETPLACE'] &&
             (!('authorFilter' in data) || (data.authorFilter is string && data.authorFilter.size() <= 64)) &&
             data.timestampMs is int && data.timestampMs > 0;
    }

    function hasNoPlaintextSecuritySecrets(data) {
      return !data.keys().hasAny([
        'rawPin', 'pin', 'password', 'passcode', 'token',
        'secret', 'privateKey', 'totpSecret', 'recoveryCodePlain'
      ]);
    }

    function isValidAccountSecurityProfile(data, userId, profileId) {
      return profileId == 'account' &&
             hasNoPlaintextSecuritySecrets(data) &&
             data.userId == userId &&
             data.sessionEpoch is int && data.sessionEpoch >= 1 &&
             data.globalSignOutAfterMs is int && data.globalSignOutAfterMs >= 0 &&
             data.lastSensitiveVerifiedAtMs is int && data.lastSensitiveVerifiedAtMs >= 0 &&
             data.protectSuspiciousChanges is bool &&
             data.alertOnNewDevice is bool &&
             data.alertOnUnusualActivity is bool &&
             data.requireReauthForSensitiveActions is bool &&
             data.changeFreezeUntilMs is int && data.changeFreezeUntilMs >= 0 &&
             data.cooldownUntilMs is int && data.cooldownUntilMs >= 0 &&
             data.failedChallengeCount is int && data.failedChallengeCount >= 0 && data.failedChallengeCount <= 50 &&
             data.suspiciousAttemptCount is int && data.suspiciousAttemptCount >= 0 && data.suspiciousAttemptCount <= 500 &&
             (!('pinHash' in data) || data.pinHash == null || (data.pinHash is string && data.pinHash.size() == 64)) &&
             (!('pinSalt' in data) || data.pinSalt == null || (data.pinSalt is string && data.pinSalt.size() >= 16 && data.pinSalt.size() <= 64)) &&
             data.twoFactorReady is bool &&
             data.preferredTwoFactorMethod in ['NONE', 'AUTHENTICATOR_TOTP', 'PASSKEY_WEBAUTHN', 'HARDWARE_KEY'] &&
             data.enrolledFactorsMeta is list && data.enrolledFactorsMeta.size() <= 8 &&
             data.backupCodesRemainingCount is int && data.backupCodesRemainingCount >= 0 && data.backupCodesRemainingCount <= 10 &&
             data.backupCodeHashes is list && data.backupCodeHashes.size() <= 10 &&
             data.updatedAtMs is int && data.updatedAtMs >= 0;
    }

    function isValidAccountSession(data, userId, sessionId) {
      return isValidId(sessionId) &&
             hasNoPlaintextSecuritySecrets(data) &&
             data.sessionId == sessionId &&
             data.userId == userId &&
             data.deviceIdHash is string && data.deviceIdHash.size() >= 8 && data.deviceIdHash.size() <= 128 &&
             data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 64 &&
             data.platformLabel is string && data.platformLabel.size() <= 32 &&
             data.status in ['ACTIVE', 'REVOKED', 'EXPIRED'] &&
             data.sessionEpoch is int && data.sessionEpoch >= 1 &&
             data.createdAtMs is int && data.createdAtMs >= 0 &&
             data.lastActivityMs is int && data.lastActivityMs >= 0 &&
             data.expiresAtMs is int && data.expiresAtMs >= 0;
    }

    function isValidConnectedDevice(data, userId, deviceIdHash) {
      return isValidId(deviceIdHash) &&
             hasNoPlaintextSecuritySecrets(data) &&
             data.deviceIdHash == deviceIdHash &&
             data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 64 &&
             data.trustState in ['TRUSTED', 'UNTRUSTED', 'BLOCKED'] &&
             data.firstSeenAtMs is int && data.firstSeenAtMs >= 0 &&
             data.lastSeenAtMs is int && data.lastSeenAtMs >= 0;
    }

    function isValidLoginHistoryEntry(data, userId, eventId) {
      return isValidId(eventId) &&
             hasNoPlaintextSecuritySecrets(data) &&
             data.id == eventId &&
             data.userId == userId &&
             data.deviceName is string && data.deviceName.size() >= 1 && data.deviceName.size() <= 64 &&
             data.authMethod is string && data.authMethod.size() >= 1 && data.authMethod.size() <= 32 &&
             data.outcome in ['SUCCESS', 'SUSPICIOUS_FLAGGED', 'CHALLENGE_REQUIRED', 'BLOCKED'] &&
             data.timestampMs is int && data.timestampMs > 0;
    }

    function isValidSecurityAlert(data, userId, alertId) {
      return isValidId(alertId) &&
             hasNoPlaintextSecuritySecrets(data) &&
             data.id == alertId &&
             data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.description is string && data.description.size() <= 500 &&
             data.severity in ['INFO', 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL'] &&
             data.status in ['OPEN', 'CONFIRMED_SAFE', 'SECURED', 'DISMISSED'] &&
             data.createdAtMs is int && data.createdAtMs > 0;
    }

    function isValidSecurityLogEntry(data, userId, logId) {
      return isValidId(logId) &&
             hasNoPlaintextSecuritySecrets(data) &&
             data.id == logId &&
             data.userId == userId &&
             data.category in ['ALL', 'SESSION', 'DEVICE', 'ANOMALY', 'PROTECTION', 'TWO_FACTOR'] &&
             data.severity in ['INFO', 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL'] &&
             data.action is string && data.action.size() >= 1 && data.action.size() <= 64 &&
             data.summary is string && data.summary.size() <= 500 &&
             data.timestampMs is int && data.timestampMs > 0;
    }

    // 1. Private User Profile (PII isolated to owner)
    match /users/{userId} {
      allow get, list: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                               incoming().userId == request.auth.uid && isValidUser(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /notifications/{notificationId} {
        allow get, list, delete: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && isValidId(notificationId) && request.auth.uid == userId &&
                                 incoming().userId == request.auth.uid && isValidNotification(incoming());
      }

      // 1.2 User-Scoped Sandboxed Extensions & Audit Logs
      match /plugins/{pluginId} {
        allow get, list, delete: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId &&
                                 isValidUserPluginState(incoming(), pluginId);
      }

      match /plugin_logs/{logId} {
        allow get, list, delete: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId &&
                         isValidPluginLog(incoming(), logId);
        allow update: if false;
      }

      // 1.3 Strictly Owner-Only Friends & Blocked Users Lists
      match /friends/{friendId} {
        allow get, list, delete: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && isValidId(friendId) && request.auth.uid == userId &&
                                 isValidFriendDoc(incoming(), userId, friendId);
      }

      match /blocked_users/{blockedUid} {
        allow get, list, delete: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && isValidId(blockedUid) && request.auth.uid == userId &&
                                 isValidBlockedDoc(incoming(), userId, blockedUid);
      }

      // 1.4 Strictly Owner-Only Global Search History
      match /search_history/{entryId} {
        allow get, list, delete: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId &&
                                 isValidSearchHistoryEntry(incoming(), userId, entryId);
      }

      // 1.5 Account Security Profile, Sessions, Devices, Alerts & Immutable Audit Trails
      match /security_profile/{profileId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId &&
                         isValidAccountSecurityProfile(incoming(), userId, profileId);
        allow update: if isSignedIn() && request.auth.uid == userId &&
                         isValidAccountSecurityProfile(incoming(), userId, profileId) &&
                         incoming().userId == existing().userId &&
                         incoming().sessionEpoch >= existing().sessionEpoch &&
                         incoming().globalSignOutAfterMs >= existing().globalSignOutAfterMs;
        allow delete: if false;
      }

      match /sessions/{sessionId} {
        allow get, list, delete: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId &&
                         isValidAccountSession(incoming(), userId, sessionId);
        allow update: if isSignedIn() && request.auth.uid == userId &&
                         isValidAccountSession(incoming(), userId, sessionId) &&
                         incoming().sessionId == existing().sessionId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAtMs == existing().createdAtMs;
      }

      match /devices/{deviceIdHash} {
        allow get, list, delete: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId &&
                                 isValidConnectedDevice(incoming(), userId, deviceIdHash);
      }

      match /login_history/{eventId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId &&
                         isValidLoginHistoryEntry(incoming(), userId, eventId);
        allow update, delete: if false;
      }

      match /security_alerts/{alertId} {
        allow get, list, delete: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId &&
                         isValidSecurityAlert(incoming(), userId, alertId);
        allow update: if isSignedIn() && request.auth.uid == userId &&
                         isValidSecurityAlert(incoming(), userId, alertId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAtMs == existing().createdAtMs;
      }

      match /security_logs/{logId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId &&
                         isValidSecurityLogEntry(incoming(), userId, logId);
        allow update, delete: if false;
      }
    }

    // 2. Public Non-PII User Profiles
    match /public_profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.isPublic == true;
      allow create, update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                               incoming().userId == request.auth.uid && incoming().isPublic == true &&
                               isValidPublicProfile(incoming());
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 3. Unique Community Handles Registry
    match /community_handles/{handle} {
      allow get: if isSignedIn() && isValidId(handle);
      allow list: if isSignedIn() && resource.data.isPublic == true;
      allow create: if isSignedIn() && isValidId(handle) && isValidCommunityHandle(incoming()) &&
                       incoming().ownerId == request.auth.uid && incoming().handle == handle;
      allow update, delete: if isSignedIn() && isValidId(handle) && existing().ownerId == request.auth.uid;
    }

    // 4. Community Invites Index
    match /community_invites/{code} {
      allow get: if isSignedIn() && isValidId(code);
      allow list: if isSignedIn() &&
                     (resource.data.createdByUid == request.auth.uid || isCommunityStaff(resource.data.serverId));
      allow create: if isSignedIn() && isValidId(code) && isValidCommunityInvite(incoming()) &&
                       incoming().createdByUid == request.auth.uid && isCommunityStaff(incoming().serverId) &&
                       (!('privacyConfig' in serverDoc(incoming().serverId).data) ||
                        !('allowInviteLinks' in serverDoc(incoming().serverId).data.privacyConfig) ||
                        serverDoc(incoming().serverId).data.privacyConfig.allowInviteLinks == true);
      allow update: if isSignedIn() && isValidId(code) && isValidCommunityInvite(incoming()) &&
                       incoming().serverId == existing().serverId &&
                       incoming().createdByUid == existing().createdByUid && (
                         isCommunityStaff(existing().serverId) ||
                         (existing().isRevoked == false &&
                          (existing().maxUses == 0 || existing().usesCount < existing().maxUses) &&
                          incoming().usesCount == existing().usesCount + 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['usesCount', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && isValidId(code) && isCommunityStaff(existing().serverId);
    }

    // 4.1 Unique Bot Handles Registry
    match /bot_handles/{handle} {
      allow get: if isSignedIn() && isValidId(handle);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(handle) && isValidBotHandle(incoming()) &&
                       incoming().ownerUid == request.auth.uid && incoming().handle == handle;
      allow update, delete: if isSignedIn() && isValidId(handle) && existing().ownerUid == request.auth.uid;
    }

    // 4.2 Raven Bots Registry & Owner-Only Secrets / Audit Logs
    match /bots/{botId} {
      allow get: if isSignedIn() && isValidId(botId) &&
                    (resource == null || existing().ownerUid == request.auth.uid || existing().isPublicCatalog == true);
      allow list: if isSignedIn() &&
                     (resource.data.ownerUid == request.auth.uid || resource.data.isPublicCatalog == true);
      allow create: if isSignedIn() && isValidId(botId) && isValidBotDoc(incoming()) &&
                       incoming().ownerUid == request.auth.uid && incoming().id == botId;
      allow update: if isSignedIn() && isValidId(botId) && isValidBotDoc(incoming()) &&
                       existing().ownerUid == request.auth.uid &&
                       incoming().ownerUid == existing().ownerUid;
      allow delete: if isSignedIn() && isValidId(botId) && existing().ownerUid == request.auth.uid;

      match /secrets/{secretId} {
        allow get: if isSignedIn() && isBotOwner(botId);
        allow list: if isSignedIn() && isBotOwner(botId) && resource.data.ownerUid == request.auth.uid;
        allow create, update: if isSignedIn() && isValidId(secretId) && isBotOwner(botId) &&
                                 incoming().ownerUid == request.auth.uid && incoming().botId == botId &&
                                 incoming().tokenHash is string && incoming().tokenHash.size() == 64;
        allow delete: if isSignedIn() && isBotOwner(botId);
      }

      match /logs/{logId} {
        allow get, list: if isSignedIn() && (isBotOwner(botId) || resource.data.ownerUid == request.auth.uid);
        allow create: if isSignedIn() && isValidId(logId) && isValidBotLog(incoming()) &&
                         incoming().botId == botId && incoming().actorUid == request.auth.uid && (
                           isBotOwner(botId) ||
                           (('serverId' in incoming()) && isValidId(incoming().serverId) &&
                            exists(/databases/$(database)/documents/servers/$(incoming().serverId)/bots/$(botId)))
                         );
        allow update, delete: if isSignedIn() && isBotOwner(botId);
      }
    }

    // 5. Communities / Servers & Nested Collaborative Resources
    match /servers/{serverId} {
      allow get: if isSignedIn() && isValidId(serverId) &&
                    (resource == null || existing().isPublic == true || existing().ownerId == request.auth.uid || request.auth.uid in existing().memberIds);
      allow list: if isSignedIn() &&
                     (resource.data.isPublic == true || resource.data.ownerId == request.auth.uid || request.auth.uid in resource.data.memberIds);
      allow create: if isSignedIn() && isValidId(serverId) && isValidServer(incoming()) &&
                       incoming().ownerId == request.auth.uid && request.auth.uid in incoming().memberIds;
      allow update: if isSignedIn() && isValidId(serverId) && isValidServer(incoming()) &&
                       incoming().ownerId == existing().ownerId && (
                         // 5a. Owner: full management including adminIds; Admin: full management (including isClosed) EXCEPT cannot mutate adminIds
                         existing().ownerId == request.auth.uid ||
                         ('adminIds' in existing() && request.auth.uid in existing().adminIds &&
                          (!('adminIds' in incoming()) ? !('adminIds' in existing()) : (('adminIds' in existing()) && incoming().adminIds == existing().adminIds))) ||

                         // 5b. Moderator: can manage events & categories or kick regular non-staff members
                         ('moderatorIds' in existing() && request.auth.uid in existing().moderatorIds &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['events', 'categories', 'memberIds', 'updatedAt'])) ||

                         // 5c. Regular member leaving community (removing only self from memberIds)
                         (request.auth.uid in existing().memberIds &&
                          request.auth.uid != existing().ownerId &&
                          !(request.auth.uid in incoming().memberIds) &&
                          incoming().memberIds.size() == existing().memberIds.size() - 1 &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'adminIds', 'moderatorIds', 'updatedAt'])) ||

                         // 5d. Regular member boosting or purchasing from internal shop
                         (request.auth.uid in existing().memberIds &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['boostCount', 'boostLevel', 'shopItems', 'updatedAt'])) ||

                         // 5e. Joining public community or private community via valid non-revoked invite
                         (!(request.auth.uid in existing().memberIds) &&
                          request.auth.uid in incoming().memberIds &&
                          incoming().memberIds.size() == existing().memberIds.size() + 1 &&
                          (
                            (existing().isPublic == true &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'updatedAt'])) ||
                            (incoming().diff(existing()).affectedKeys().hasOnly(['memberIds', 'lastInviteCodeUsed', 'updatedAt']) &&
                             (!('privacyConfig' in existing()) ||
                              !('allowInviteLinks' in existing().privacyConfig) ||
                              existing().privacyConfig.allowInviteLinks == true) &&
                             hasValidCommunityInvite(serverId, incoming()))
                          ))
                       );
      allow delete: if isSignedIn() && isValidId(serverId) && existing().ownerId == request.auth.uid;

      // 5.0 Installed Bots & Server-Scoped Permissions / Roles
      match /bots/{botId} {
        allow get, list: if isSignedIn() && isServerMemberOrPublic(serverId);
        allow create, update: if isSignedIn() && isValidId(botId) && isCommunityAdmin(serverId) &&
                                 isValidServerBotInstallation(incoming(), serverId, botId) &&
                                 botExists(botId) &&
                                 (botDoc(botId).data.ownerUid == request.auth.uid || botDoc(botId).data.isPublicCatalog == true);
        allow delete: if isSignedIn() && isValidId(botId) && (isCommunityAdmin(serverId) || isBotOwner(botId));
      }

      // 5.0b Protected Server Admin & Security Settings
      match /admin_settings/{settingId} {
        allow get, list: if isSignedIn() && isValidId(settingId) && (
          (settingId == 'security' && isCommunityStaff(serverId)) ||
          (settingId == 'public_policy' && isServerMemberOrPublic(serverId))
        );
        allow create, update: if isSignedIn() && isValidId(settingId) && isCommunityAdmin(serverId) && (
          (settingId == 'security' && isValidAdminSecuritySettings(incoming(), serverId)) ||
          (settingId == 'public_policy' && isValidAdminPublicPolicy(incoming(), serverId))
        );
        allow delete: if isSignedIn() && isValidId(settingId) && isServerOwner(serverId);
      }

      // 5.1 Community Members & Granular Role Assignments
      match /members/{memberId} {
        allow get: if isSignedIn() && isValidId(memberId) &&
                      (resource == null || resource.data.isPublic == true || isServerMemberOrPublic(serverId) || request.auth.uid == memberId);
        allow list: if isSignedIn() &&
                       (resource.data.isPublic == true || isServerMemberOrPublic(serverId) || resource.data.uid == request.auth.uid);
        allow create: if isSignedIn() && isValidId(memberId) && isValidCommunityMember(incoming()) &&
                         incoming().serverId == serverId && (
                           isServerOwner(serverId) ||
                           (isCommunityAdmin(serverId) && incoming().role != 'ADMIN') ||
                           (memberId == request.auth.uid && incoming().uid == request.auth.uid &&
                            incoming().role == 'MEMBER' && isServerMemberOrPublic(serverId))
                         );
        allow update: if isSignedIn() && isValidId(memberId) && isValidCommunityMember(incoming()) &&
                         incoming().serverId == serverId && incoming().uid == existing().uid && (
                           isServerOwner(serverId) ||
                           (isCommunityAdmin(serverId) && existing().role != 'ADMIN' && incoming().role != 'ADMIN') ||
                           (isCommunityMod(serverId) && existing().role == 'MEMBER' && incoming().role == 'MEMBER' &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['isTimedOut', 'updatedAt'])) ||
                           (memberId == request.auth.uid &&
                            incoming().role == existing().role &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarUrl', 'avatarColor', 'status', 'xp', 'level', 'clanTag', 'updatedAt']))
                         );
        allow delete: if isSignedIn() && isValidId(memberId) && (
                           (memberId == request.auth.uid && !isServerOwner(serverId)) ||
                           (isServerOwner(serverId) && memberId != serverDoc(serverId).data.ownerId) ||
                           (isCommunityAdmin(serverId) && memberId != serverDoc(serverId).data.ownerId && existing().role != 'ADMIN') ||
                           (isCommunityMod(serverId) && existing().role == 'MEMBER')
                         );
      }

      // 5.2 Community Announcements (Staff-only publish/edit/delete)
      match /announcements/{announcementId} {
        allow get: if isSignedIn() && isValidId(announcementId) && isServerMemberOrPublic(serverId);
        allow list: if isSignedIn() && (resource.data.isPublic == true || request.auth.uid in resource.data.memberIds);
        allow create, update, delete: if isSignedIn() && isValidId(announcementId) &&
                                         (request.method == 'delete' || isValidAnnouncement(incoming())) &&
                                         isCommunityStaff(serverId);
      }

      // 5.3 Community Events (Staff manage, Members RSVP)
      match /events/{eventId} {
        allow get: if isSignedIn() && isValidId(eventId) && isServerMemberOrPublic(serverId);
        allow list: if isSignedIn() && (resource.data.isPublic == true || request.auth.uid in resource.data.memberIds);
        allow create, delete: if isSignedIn() && isValidId(eventId) &&
                                 (request.method == 'delete' || isValidCommunityEvent(incoming())) &&
                                 isCommunityStaff(serverId);
        allow update: if isSignedIn() && isValidId(eventId) && isValidCommunityEvent(incoming()) && (
                           isCommunityStaff(serverId) ||
                           (isServerMemberOrPublic(serverId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['interestedUserIds', 'updatedAt']))
                         );
      }

      // 5.4 Channels (Staff manage structure; members may post typing indicator)
      match /channels/{channelId} {
        allow get: if isSignedIn() && isValidId(channelId) && isServerMemberOrPublic(serverId);
        allow list: if isSignedIn() && (resource.data.isPublic == true || request.auth.uid in resource.data.memberIds);
        allow create: if isSignedIn() && isValidId(channelId) && isValidChannel(incoming()) && isCommunityStaff(serverId);
        allow update: if isSignedIn() && isValidId(channelId) && isValidChannel(incoming()) && (
                           isCommunityAdmin(serverId) ||
                           (isCommunityMod(serverId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['isLocked', 'slowmodeSeconds', 'isReadOnly', 'kickedVoiceUids', 'topic', 'updatedAt'])) ||
                           (isServerMemberOrPublic(serverId) &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['lastTypingUid', 'lastTypingName', 'lastTypingMs']))
                         );
        allow delete: if isSignedIn() && isValidId(channelId) && isCommunityAdmin(serverId);

        match /messages/{messageId} {
          allow get: if isSignedIn() && isValidId(messageId) && isServerMemberOrPublic(serverId);
          allow list: if isSignedIn() && (resource.data.isPublic == true || request.auth.uid in resource.data.memberIds);
          allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming()) && isServerMemberOrPublic(serverId) &&
                           (!isServerClosed(serverId) || isCommunityAdmin(serverId)) && (
                           incoming().senderId == request.auth.uid ||
                           (('isBotMessage' in incoming()) && incoming().isBotMessage == true &&
                            ('triggeredByUid' in incoming()) && incoming().triggeredByUid == request.auth.uid &&
                            ('botId' in incoming()) && isValidId(incoming().botId) &&
                            exists(/databases/$(database)/documents/servers/$(serverId)/bots/$(incoming().botId)) &&
                            get(/databases/$(database)/documents/servers/$(serverId)/bots/$(incoming().botId)).data.isEnabledInServer == true)
                         );
          allow update: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming()) &&
                           incoming().senderId == existing().senderId && isServerMemberOrPublic(serverId) && (
                             (existing().senderId == request.auth.uid &&
                              incoming().diff(existing()).affectedKeys().hasOnly(['text', 'isEdited', 'isPinned', 'reactions', 'poll', 'threadCount', 'updatedAt'])) ||
                             incoming().diff(existing()).affectedKeys().hasOnly(['reactions', 'isPinned', 'poll', 'threadCount', 'updatedAt'])
                           );
          allow delete: if isSignedIn() && isValidId(messageId) && isServerMemberOrPublic(serverId) &&
                           (existing().senderId == request.auth.uid || isCommunityStaff(serverId));
        }

        match /whiteboard/{canvasId} {
          allow get: if isSignedIn() && isValidId(canvasId) && isServerMemberOrPublic(serverId);
          allow list: if isSignedIn() && (resource.data.isPublic == true || request.auth.uid in resource.data.memberIds);
          allow create, update: if isSignedIn() && isValidId(canvasId) && isValidWhiteboard(incoming()) &&
                                   incoming().updatedBy == request.auth.uid && isServerMemberOrPublic(serverId);
        }

        match /jukebox/{jukeboxId} {
          allow get: if isSignedIn() && isValidId(jukeboxId) && isServerMemberOrPublic(serverId);
          allow list: if isSignedIn() && (resource.data.isPublic == true || request.auth.uid in resource.data.memberIds);
          allow create, update: if isSignedIn() && isValidId(jukeboxId) && isValidJukebox(incoming()) &&
                                   incoming().updatedBy == request.auth.uid && isServerMemberOrPublic(serverId);
        }

        match /voice_peers/{peerId} {
          allow get: if isSignedIn() && isValidId(peerId) && isServerMemberOrPublic(serverId);
          allow list: if isSignedIn() && (resource.data.isPublic == true || request.auth.uid in resource.data.memberIds);
          allow create, update: if isSignedIn() && isValidId(peerId) && peerId == request.auth.uid &&
                                   incoming().uid == request.auth.uid && isValidVoicePeer(incoming()) &&
                                   canJoinVoiceChannel(serverId, channelId);
          allow delete: if isSignedIn() && isValidId(peerId) && isServerMemberOrPublic(serverId) &&
                           (peerId == request.auth.uid || isCommunityStaff(serverId));
        }

        match /rtc_signals/{signalId} {
          allow get: if isSignedIn() && isValidId(signalId) &&
                        (existing().toUid == request.auth.uid || existing().fromUid == request.auth.uid);
          allow list: if isSignedIn() &&
                         (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
          allow create: if isSignedIn() && isValidId(signalId) && isValidRtcSignal(incoming()) &&
                           incoming().fromUid == request.auth.uid && isServerMemberOrPublic(serverId);
          allow delete: if isSignedIn() && isValidId(signalId) &&
                           (existing().toUid == request.auth.uid || existing().fromUid == request.auth.uid);
        }
      }
    }

    // 6. Direct Conversations & Canonical Friend Requests
    match /friend_requests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) &&
                    (resource == null || request.auth.uid in existing().participantIds);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && isValidId(requestId) &&
                       isValidFriendRequestDoc(incoming(), requestId) &&
                       incoming().fromUid == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       hasNoBlockBetween(incoming().fromUid, incoming().toUid) &&
                       !areAlreadyFriends(incoming().fromUid, incoming().toUid) &&
                       recipientAllowsFriendRequest(incoming().fromUid, incoming().toUid, incoming());
      allow update: if isSignedIn() && isValidId(requestId) &&
                       isValidFriendRequestDoc(incoming(), requestId) &&
                       request.auth.uid in existing().participantIds && (
                         // 6a. Pending -> ACCEPTED / DECLINED (recipient only) or CANCELLED (sender only)
                         (existing().status == 'PENDING' &&
                          incoming().fromUid == existing().fromUid &&
                          incoming().toUid == existing().toUid &&
                          incoming().participantIds == existing().participantIds && (
                            (existing().toUid == request.auth.uid &&
                             incoming().status in ['ACCEPTED', 'DECLINED'] &&
                             (incoming().status != 'ACCEPTED' || hasNoBlockBetween(existing().fromUid, existing().toUid))) ||
                            (existing().fromUid == request.auth.uid && incoming().status == 'CANCELLED')
                          )) ||
                         // 6b. Accepted -> CANCELLED by either participant on unfriend or block
                         (existing().status == 'ACCEPTED' &&
                          incoming().status == 'CANCELLED' &&
                          incoming().fromUid == existing().fromUid &&
                          incoming().toUid == existing().toUid &&
                          incoming().participantIds == existing().participantIds) ||
                         // 6c. Re-sending friend request on canonical pairId after DECLINED / CANCELLED
                         (existing().status in ['DECLINED', 'CANCELLED'] &&
                          incoming().status == 'PENDING' &&
                          incoming().fromUid == request.auth.uid &&
                          incoming().toUid in existing().participantIds &&
                          incoming().fromUid in existing().participantIds &&
                          hasNoBlockBetween(incoming().fromUid, incoming().toUid) &&
                          !areAlreadyFriends(incoming().fromUid, incoming().toUid) &&
                          recipientAllowsFriendRequest(incoming().fromUid, incoming().toUid, incoming()))
                       );
      allow delete: if isSignedIn() && isValidId(requestId) &&
                       request.auth.uid in existing().participantIds;
    }

    match /direct_conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && (resource == null || request.auth.uid in existing().participantIds);
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() && isValidId(conversationId) && isValidDirectConversation(incoming()) &&
                       request.auth.uid in incoming().participantIds &&
                       twoPartyDmCreateAllowed(incoming().participantIds);
      allow update: if isSignedIn() && isValidId(conversationId) && isValidDirectConversation(incoming()) &&
                       request.auth.uid in existing().participantIds &&
                       request.auth.uid in incoming().participantIds &&
                       twoPartyDmNoBlock(incoming().participantIds);

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(messageId) &&
                      request.auth.uid in get(/databases/$(database)/documents/direct_conversations/$(conversationId)).data.participantIds;
        allow list: if isSignedIn() && request.auth.uid in resource.data.participantIds;
        allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming()) &&
                         request.auth.uid in get(/databases/$(database)/documents/direct_conversations/$(conversationId)).data.participantIds &&
                         twoPartyDmNoBlock(get(/databases/$(database)/documents/direct_conversations/$(conversationId)).data.participantIds) && (
                           incoming().senderId == request.auth.uid ||
                           (('isBotMessage' in incoming()) && incoming().isBotMessage == true &&
                            ('triggeredByUid' in incoming()) && incoming().triggeredByUid == request.auth.uid &&
                            ('botId' in incoming()) && isValidId(incoming().botId) &&
                            botExists(incoming().botId) &&
                            botDoc(incoming().botId).data.isActive == true &&
                            (botDoc(incoming().botId).data.ownerUid == request.auth.uid || botDoc(incoming().botId).data.isPublicCatalog == true) &&
                            (
                              (('isBotChat' in get(/databases/$(database)/documents/direct_conversations/$(conversationId)).data) &&
                               get(/databases/$(database)/documents/direct_conversations/$(conversationId)).data.isBotChat == true &&
                               get(/databases/$(database)/documents/direct_conversations/$(conversationId)).data.botId == incoming().botId &&
                               (!('allowDirectMessages' in botDoc(incoming().botId).data) || botDoc(incoming().botId).data.allowDirectMessages == true)) ||
                              ((!('isBotChat' in get(/databases/$(database)/documents/direct_conversations/$(conversationId)).data) ||
                                get(/databases/$(database)/documents/direct_conversations/$(conversationId)).data.isBotChat == false) &&
                               (!('allowGroupMentions' in botDoc(incoming().botId).data) || botDoc(incoming().botId).data.allowGroupMentions == true))
                            ))
                         );
        allow update: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming()) &&
                         incoming().senderId == existing().senderId &&
                         request.auth.uid in get(/databases/$(database)/documents/direct_conversations/$(conversationId)).data.participantIds;
        allow delete: if isSignedIn() && isValidId(messageId) && existing().senderId == request.auth.uid;
      }
    }

    // 7. RAVEN Stories, Audience Privacy, Author-Only View Tracking & Likes (Author-Only Deletion)
    match /stories/{storyId} {
      allow get: if isSignedIn() && isValidId(storyId) &&
                    (resource == null || canViewStoryDoc(existing()));
      allow list: if isSignedIn() && (
                     resource.data.visibility == 'PUBLIC' ||
                     resource.data.authorId == request.auth.uid ||
                     request.auth.uid in resource.data.allowedViewerIds
                   );
      allow create: if isSignedIn() && isValidId(storyId) &&
                       isValidStoryDoc(incoming()) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().viewCount == 0 &&
                       (!('viewerIds' in incoming()) || incoming().viewerIds.size() == 0) &&
                       (!('likesCount' in incoming()) || incoming().likesCount == 0) &&
                       (!('likedByIds' in incoming()) || incoming().likedByIds.size() == 0);
      allow update: if isSignedIn() && isValidId(storyId) &&
                       incoming().authorId == existing().authorId &&
                       incoming().createdAtMs == existing().createdAtMs &&
                       incoming().expiresAtMs == existing().expiresAtMs && (
                         // 7a. Author adjusting privacy settings
                         (incoming().diff(existing()).affectedKeys().hasOnly(['visibility', 'allowedViewerIds', 'caption', 'updatedAt']) &&
                          existing().authorId == request.auth.uid &&
                          isValidStoryDoc(incoming())) ||
                         // 7b. Authorized viewer recording a view (incrementing once)
                         (incoming().diff(existing()).affectedKeys().hasOnly(['viewerIds', 'viewCount', 'updatedAt']) &&
                          incoming().viewCount is int &&
                          incoming().viewCount >= existing().viewCount &&
                          incoming().viewCount <= existing().viewCount + 1 &&
                          (!('viewerIds' in incoming()) || (incoming().viewerIds is list && incoming().viewerIds.size() <= 500 && request.auth.uid in incoming().viewerIds)) &&
                          canViewStoryDoc(existing())) ||
                         // 7c. Non-author viewer liking or unliking the story (+1 / -1)
                         (incoming().diff(existing()).affectedKeys().hasOnly(['likedByIds', 'likesCount', 'updatedAt']) &&
                          existing().authorId != request.auth.uid &&
                          incoming().likedByIds is list &&
                          incoming().likedByIds.size() <= 1000 &&
                          incoming().likesCount is int &&
                          incoming().likesCount >= 0 &&
                          (
                            ((!('likedByIds' in existing()) || !(request.auth.uid in existing().likedByIds)) &&
                             request.auth.uid in incoming().likedByIds &&
                             ((!('likesCount' in existing()) && incoming().likesCount == 1) ||
                              (('likesCount' in existing()) && incoming().likesCount == existing().likesCount + 1))) ||
                            (('likedByIds' in existing()) &&
                             request.auth.uid in existing().likedByIds &&
                             !(request.auth.uid in incoming().likedByIds) &&
                             ('likesCount' in existing()) &&
                             existing().likesCount > 0 &&
                             incoming().likesCount == existing().likesCount - 1)
                          ) &&
                          canViewStoryDoc(existing()))
                       );
      allow delete: if isSignedIn() && isValidId(storyId) &&
                       existing().authorId == request.auth.uid;

      match /views/{viewerId} {
        allow get: if isSignedIn() && isValidId(viewerId) && storyExists(storyId) &&
                      (storyDoc(storyId).data.authorId == request.auth.uid ||
                       viewerId == request.auth.uid);
        allow list: if isSignedIn() && storyExists(storyId) &&
                       storyDoc(storyId).data.authorId == request.auth.uid;
        allow create, update: if isSignedIn() && isValidId(viewerId) &&
                                 viewerId == request.auth.uid &&
                                 storyExists(storyId) &&
                                 canViewStoryDoc(storyDoc(storyId).data) &&
                                 isValidStoryView(incoming(), storyId);
        allow delete: if isSignedIn() && isValidId(viewerId) && (
                           viewerId == request.auth.uid ||
                           !storyExists(storyId) ||
                           storyDoc(storyId).data.authorId == request.auth.uid
                         );
      }
    }

    // 8. RAVEN Advanced Polls, Anonymous Voting, Role Restrictions & Anti-Fraud Tallies
    match /polls/{pollId} {
      allow get: if isSignedIn() && isValidId(pollId) && (
                    resource == null ||
                    existing().authorId == request.auth.uid ||
                    (existing().status != 'DRAFT' && (
                      existing().isPublic == true ||
                      (('serverId' in existing()) && existing().serverId != null && isServerMemberOrPublic(existing().serverId)) ||
                      (('memberIds' in existing()) && request.auth.uid in existing().memberIds)
                    ))
                  );
      allow list: if isSignedIn() && (
                     resource.data.authorId == request.auth.uid ||
                     resource.data.isPublic == true ||
                     request.auth.uid in resource.data.memberIds
                   );
      allow create: if isSignedIn() && isValidId(pollId) && isValidPollDoc(incoming(), pollId) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().totalVotes == 0 &&
                       incoming().totalVoters == 0 &&
                       incoming().status in ['DRAFT', 'PUBLISHED'] &&
                       (incoming().visibility == 'PUBLIC' ||
                        (('serverId' in incoming()) && incoming().serverId != null && isServerMemberOrPublic(incoming().serverId)));
      allow update: if isSignedIn() && isValidId(pollId) &&
                       incoming().authorId == existing().authorId &&
                       incoming().id == existing().id && (
                         // 8a. Author editing or publishing DRAFT before publication (zero votes guaranteed)
                         (existing().status == 'DRAFT' &&
                          existing().authorId == request.auth.uid &&
                          isValidPollDoc(incoming(), pollId) &&
                          incoming().status in ['DRAFT', 'PUBLISHED'] &&
                          incoming().totalVotes == 0 &&
                          incoming().totalVoters == 0) ||
                         // 8b. Author or Community Staff manually closing a PUBLISHED poll (cannot alter tallies)
                         (existing().status == 'PUBLISHED' &&
                          incoming().status == 'CLOSED' &&
                          (existing().authorId == request.auth.uid ||
                           (('serverId' in existing()) && existing().serverId != null && isCommunityStaff(existing().serverId))) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'closedAtMs', 'updatedAtMs', 'updatedAt'])) ||
                         // 8c. Eligible voter atomically updating poll tallies in lockstep with /votes/{uid}
                         (existing().status == 'PUBLISHED' &&
                          incoming().status == 'PUBLISHED' &&
                          (!('expiresAtMs' in existing()) || existing().expiresAtMs == null || request.time.toMillis() <= existing().expiresAtMs) &&
                          isEligiblePollVoter(existing()) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['optionCounts', 'totalVotes', 'totalVoters', 'updatedAtMs', 'updatedAt']) &&
                          incoming().optionCounts is map &&
                          incoming().optionCounts.keys().hasAll(existing().optionCounts.keys()) &&
                          existing().optionCounts.keys().hasAll(incoming().optionCounts.keys()) &&
                          validPollTallyUpdate(pollId, existing(), incoming()))
                       );
      allow delete: if isSignedIn() && isValidId(pollId) && (
                       existing().authorId == request.auth.uid ||
                       (('serverId' in existing()) && existing().serverId != null && isCommunityAdmin(existing().serverId))
                     );

      match /votes/{voteId} {
        allow get: if isSignedIn() && isValidId(voteId) && (
                      voteId == request.auth.uid || canReadPollVotes(pollId)
                    );
        allow list: if isSignedIn() && (
                       resource.data.voterId == request.auth.uid || canReadPollVotes(pollId)
                     );
        allow create: if isSignedIn() && canWriteVote(pollId, voteId, true);
        allow update: if isSignedIn() && existing().voterId == request.auth.uid && canWriteVote(pollId, voteId, false);
        allow delete: if isSignedIn() && canDeleteVote(pollId, voteId);
      }
    }

    // 9. RAVEN Advanced Events (Public/Private, Voice/Server, RSVP, Waitlist, Reminders & History)
    match /events/{eventId} {
      allow get: if isSignedIn() && isValidId(eventId) &&
                    (resource == null || canViewRavenEvent(existing()));
      allow list: if isSignedIn() && (
                     resource.data.creatorId == request.auth.uid ||
                     resource.data.isPublic == true ||
                     request.auth.uid in resource.data.memberIds ||
                     request.auth.uid in resource.data.invitedUserIds
                   );
      allow create: if isSignedIn() && isValidId(eventId) &&
                       isValidRavenEvent(incoming(), eventId) &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().status == 'SCHEDULED' &&
                       incoming().waitlistIds.size() == 0 &&
                       incoming().goingIds.size() <= 1 &&
                       (incoming().goingIds.size() == 0 || request.auth.uid in incoming().goingIds) &&
                       (!('serverId' in incoming()) || incoming().serverId == null || canManageServerEvents(incoming().serverId));
      allow update: if isSignedIn() && isValidId(eventId) &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().id == existing().id && (
                         // 9a. Creator or Server Staff editing, cancelling, or expanding capacity
                         (canManageRavenEvent(existing()) &&
                          isValidRavenEvent(incoming(), eventId) &&
                          (incoming().status != 'CANCELLED' || existing().status == 'SCHEDULED')) ||
                         // 9b. Eligible attendee updating RSVP / waitlist + FIFO promotion
                         (canViewRavenEvent(existing()) &&
                          validEventRsvpUpdate(existing(), incoming()))
                       );
      allow delete: if isSignedIn() && isValidId(eventId) && canManageRavenEvent(existing());

      match /rsvps/{rsvpId} {
        allow get, list: if isSignedIn() && eventExists(eventId) && canViewRavenEvent(eventDoc(eventId).data);
        allow create, update: if isSignedIn() && isValidId(rsvpId) && rsvpId == request.auth.uid &&
                                 eventExists(eventId) && canViewRavenEvent(eventDoc(eventId).data) &&
                                 incoming().uid == request.auth.uid &&
                                 incoming().eventId == eventId &&
                                 incoming().displayName is string && incoming().displayName.size() >= 1 && incoming().displayName.size() <= 64 &&
                                 incoming().status is string && incoming().status in ['GOING', 'MAYBE', 'WAITLISTED', 'NOT_GOING'];
        allow delete: if isSignedIn() && isValidId(rsvpId) &&
                         (rsvpId == request.auth.uid || (eventExists(eventId) && canManageRavenEvent(eventDoc(eventId).data)));
      }

      match /reminders/{reminderId} {
        allow get: if isSignedIn() && isValidId(reminderId) &&
                      (resource == null || existing().userId == request.auth.uid);
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
        allow create, update: if isSignedIn() && isValidId(reminderId) &&
                                 incoming().userId == request.auth.uid &&
                                 incoming().eventId == eventId &&
                                 incoming().minutesBefore is int &&
                                 incoming().minutesBefore >= 0 && incoming().minutesBefore <= 10080 &&
                                 incoming().triggerAtMs is int &&
                                 incoming().triggered is bool &&
                                 eventExists(eventId) && canViewRavenEvent(eventDoc(eventId).data);
        allow delete: if isSignedIn() && isValidId(reminderId) &&
                         (existing().userId == request.auth.uid || (eventExists(eventId) && canManageRavenEvent(eventDoc(eventId).data)));
      }

      match /history/{entryId} {
        allow get, list: if isSignedIn() && eventExists(eventId) && canViewRavenEvent(eventDoc(eventId).data);
        allow create: if isSignedIn() && isValidId(entryId) &&
                         eventExists(eventId) &&
                         incoming().id == entryId &&
                         incoming().eventId == eventId &&
                         incoming().actorId == request.auth.uid &&
                         incoming().actionType is string &&
                         incoming().actionType in ['CREATED', 'UPDATED', 'CANCELLED', 'RSVP_GOING', 'RSVP_MAYBE', 'RSVP_WAITLIST', 'RSVP_CANCELLED', 'WAITLIST_PROMOTED', 'COMPLETED'] &&
                         incoming().summary is string && incoming().summary.size() >= 1 && incoming().summary.size() <= 400 && (
                           canManageRavenEvent(eventDoc(eventId).data) ||
                           (canViewRavenEvent(eventDoc(eventId).data) &&
                            incoming().actionType in ['RSVP_GOING', 'RSVP_MAYBE', 'RSVP_WAITLIST', 'RSVP_CANCELLED', 'WAITLIST_PROMOTED'])
                         );
        allow update: if false;
        allow delete: if isSignedIn() && eventExists(eventId) && canManageRavenEvent(eventDoc(eventId).data);
      }
    }
  }
}
